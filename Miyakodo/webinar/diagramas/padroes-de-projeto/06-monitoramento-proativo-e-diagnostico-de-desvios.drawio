<mxfile host="app.diagrams.net" agent="Miyakodo Webinar">
  <diagram id="padrao-06" name="Monitoramento proativo de desvios">
    <mxGraphModel dx="1280" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="860" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Cabecalho -->
        <mxCell id="title" value="Padrão 6: Monitoramento proativo e diagnóstico de desvios" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=26;fontStyle=1;fontColor=#1e1e1e;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Espelho proativo do Talk to your data: detecção determinística de desvios -&gt; agente investigador -&gt; alerta acionável" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1200" height="28" as="geometry" />
        </mxCell>

        <!-- Zona Container Principal (fundo, antes das caixas internas) -->
        <mxCell id="zone_cloud" value="MONITORAMENTO EM NUVEM  |  Workflow agendado + Harness próprio" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ebfbee;strokeColor=#22c55e;strokeWidth=2;verticalAlign=top;align=left;spacingTop=10;spacingLeft=16;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#15803d;" vertex="1" parent="1">
          <mxGeometry x="270" y="118" width="710" height="468" as="geometry" />
        </mxCell>

        <!-- Entrada: Operacao viva da empresa -->
        <mxCell id="box_operacao" value="&lt;div style=&quot;font-size:14px;font-weight:bold;margin-bottom:10px;&quot;&gt;Operação viva da empresa&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.45;&quot;&gt;&lt;b&gt;Dados estruturados:&lt;/b&gt;&lt;br/&gt;ERP, financeiro, estoque, CRM e logística&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Contexto textual:&lt;/b&gt;&lt;br/&gt;E-mails comerciais, chamados, ocorrências e notas&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#a5d8ff;strokeColor=#4a9eed;strokeWidth=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="160" height="400" as="geometry" />
        </mxCell>

        <!-- Linha superior dentro do container -->
        <mxCell id="box_deteccao" value="&lt;div style=&quot;font-size:13px;font-weight:bold;margin-bottom:6px;&quot;&gt;1. Detecção determinística&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;line-height:1.38;&quot;&gt;Regras diretas no banco: margem, ruptura, atraso, despesa ou cliente sumindo.&lt;br/&gt;&lt;b&gt;Só aciona IA com desvio real.&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#ffd8a8;strokeColor=#f59e0b;strokeWidth=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="285" y="170" width="180" height="160" as="geometry" />
        </mxCell>

        <mxCell id="box_agente" value="&lt;div style=&quot;font-size:13px;font-weight:bold;margin-bottom:6px;&quot;&gt;2. Agente Investigador&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;line-height:1.38;&quot;&gt;&lt;b&gt;Model Routing:&lt;/b&gt; triagem rápida e diagnóstico profundo.&lt;br/&gt;&lt;b&gt;System Prompt&lt;/b&gt; exige causa com evidências nos dados.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#d0bfff;strokeColor=#8b5cf6;strokeWidth=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="535" y="170" width="180" height="160" as="geometry" />
        </mxCell>

        <mxCell id="box_saida" value="&lt;div style=&quot;font-size:13px;font-weight:bold;margin-bottom:6px;&quot;&gt;3. Saída estruturada&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;line-height:1.38;&quot;&gt;Alerta padronizado com severidade, impacto financeiro, causa com evidências, dono e ação sugerida.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#b2f2bb;strokeColor=#22c55e;strokeWidth=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="785" y="170" width="180" height="160" as="geometry" />
        </mxCell>

        <!-- Linha inferior dentro do container -->
        <mxCell id="box_dados" value="&lt;div style=&quot;font-size:13px;font-weight:bold;margin-bottom:6px;&quot;&gt;Camada de dados e ações&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;line-height:1.38;&quot;&gt;&lt;b&gt;MCP / Tools:&lt;/b&gt; consultas ao ERP, CRM e financeiro (só leitura).&lt;br/&gt;&lt;b&gt;RAG:&lt;/b&gt; busca e-mails, chamados e ocorrências.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#c3fae8;strokeColor=#06b6d4;strokeWidth=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="285" y="410" width="180" height="160" as="geometry" />
        </mxCell>

        <mxCell id="box_skills" value="&lt;div style=&quot;font-size:13px;font-weight:bold;margin-bottom:6px;&quot;&gt;Repositório de Skills&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;line-height:1.38;&quot;&gt;Roteiros de diagnóstico por área (margem, estoque, frete, inadimplência e churn) mantidos pelos líderes.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#c3fae8;strokeColor=#06b6d4;strokeWidth=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="535" y="410" width="180" height="160" as="geometry" />
        </mxCell>

        <mxCell id="box_memoria" value="&lt;div style=&quot;font-size:13px;font-weight:bold;margin-bottom:6px;&quot;&gt;Memória anti-ruído&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;line-height:1.38;&quot;&gt;Registra desvios já alertados, exceções justificadas e evolução diária para evitar fadiga de alerta.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#c3fae8;strokeColor=#06b6d4;strokeWidth=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="785" y="410" width="180" height="160" as="geometry" />
        </mxCell>

        <!-- Saida a direita: Envio proativo e Human-in-the-loop -->
        <mxCell id="box_alerta_proativo" value="&lt;div style=&quot;font-size:13px;font-weight:bold;margin-bottom:6px;&quot;&gt;Alerta proativo&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;line-height:1.38;&quot;&gt;Entrega direta no canal que o decisor já usa: WhatsApp, Slack, Teams ou e-mail.&lt;br/&gt;&lt;b&gt;Sem precisar abrir chat.&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#ffd8a8;strokeColor=#f59e0b;strokeWidth=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1050" y="170" width="190" height="160" as="geometry" />
        </mxCell>

        <mxCell id="box_hitl" value="&lt;div style=&quot;font-size:13px;font-weight:bold;margin-bottom:6px;&quot;&gt;Human-in-the-loop&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;line-height:1.38;&quot;&gt;Sócio ou gestor valida o diagnóstico, decide a ação corretiva e marca exceções conhecidas na memória.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#fff3bf;strokeColor=#f59e0b;strokeWidth=3;fontColor=#1e1e1e;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1050" y="410" width="190" height="160" as="geometry" />
        </mxCell>

        <!-- Conexoes (setas ortogonais limpas) -->
        <mxCell id="e1" value="ciclo&lt;br/&gt;agendado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="box_operacao" target="box_deteccao">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-8" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e2" value="leitura&lt;br/&gt;direta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0891b2;strokeWidth=2;dashed=1;dashPattern=6 4;startArrow=classic;startFill=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="box_operacao" target="box_dados">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-8" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e3" value="desvio&lt;br/&gt;real" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="box_deteccao" target="box_agente">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="gera&lt;br/&gt;alerta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="box_agente" target="box_saida">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" value="cruza dados&lt;br/&gt;e textos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="box_agente" target="box_dados">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="571" y="370" />
              <mxPoint x="375" y="370" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e6" value="segue&lt;br/&gt;roteiros" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="box_agente" target="box_skills">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e7" value="checa e grava&lt;br/&gt;histórico" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="box_agente" target="box_memoria">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="679" y="370" />
              <mxPoint x="875" y="370" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e8" value="envia no&lt;br/&gt;canal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="box_saida" target="box_alerta_proativo">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="8" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e9" value="só o que&lt;br/&gt;importa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="box_alerta_proativo" target="box_hitl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e10" value="marca&lt;br/&gt;exceções" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="box_hitl" target="box_memoria">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="8" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Divisoria sutil para faixa inferior -->
        <mxCell id="divider" value="" style="endArrow=none;html=1;strokeColor=#e5e7eb;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="40" y="610" as="sourcePoint" />
            <mxPoint x="1240" y="610" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Faixa inferior -->
        <mxCell id="footer_title" value="Por que esse padrão protege margem antes do fechamento do mês:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#1e1e1e;" vertex="1" parent="1">
          <mxGeometry x="40" y="632" width="1200" height="28" as="geometry" />
        </mxCell>

        <mxCell id="card_1" value="&lt;div style=&quot;font-size:13.5px;font-weight:bold;margin-bottom:6px;&quot;&gt;1. Código detecta o desvio, IA explica o porquê&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.4;&quot;&gt;Regras determinísticas vigiam indicadores com custo mínimo. A IA só entra quando há anomalia real, cruzando números do ERP com e-mails e chamados.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#b2f2bb;strokeColor=#22c55e;strokeWidth=2;fontColor=#1e1e1e;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="672" width="380" height="118" as="geometry" />
        </mxCell>

        <mxCell id="card_2" value="&lt;div style=&quot;font-size:13.5px;font-weight:bold;margin-bottom:6px;&quot;&gt;2. Memória e Evals evitam fadiga de alerta&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.4;&quot;&gt;O harness lembra o que já foi avisado ou justificado e mede sinal vs ruído (alertas úteis vs falsos alarmes), mantendo o gestor focado no que importa.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#b2f2bb;strokeColor=#22c55e;strokeWidth=2;fontColor=#1e1e1e;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="672" width="380" height="118" as="geometry" />
        </mxCell>

        <mxCell id="card_3" value="&lt;div style=&quot;font-size:13.5px;font-weight:bold;margin-bottom:6px;&quot;&gt;3. Ação corretiva na hora, humano no comando&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.4;&quot;&gt;O alerta chega no WhatsApp ou Teams com impacto financeiro e evidências. O gestor age na mesma semana, sem autonomia cega da IA sobre caixa ou operação.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#b2f2bb;strokeColor=#22c55e;strokeWidth=2;fontColor=#1e1e1e;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="672" width="380" height="118" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
