          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_ia_esp" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;startArrow=classic;startFill=1;endArrow=classic;endFill=1;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ia" target="especialista">
