        <!-- Conector MCP -->
        <mxCell id="mcp" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;MCP&lt;/b&gt;&lt;div style=&quot;font-size: 11px; color: #1e293b; margin-top: 8px;&quot;&gt;MCP interno (RAG)&lt;br&gt;&lt;b&gt;ou&lt;/b&gt;&lt;br&gt;MCP nativo / Tools&lt;br&gt;(pastas)&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#c3fae8;strokeColor=#06b6d4;strokeWidth=2;fontColor=#1e1e1e;" vertex="1" parent="1">
          <mxGeometry x="438" y="210" width="134" height="130" as="geometry" />
