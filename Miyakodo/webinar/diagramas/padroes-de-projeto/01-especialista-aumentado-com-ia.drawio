        <mxCell id="title" value="Padrão 1: Especialista aumentado com IA" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=26;fontStyle=1;fontColor=#1e1e1e;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Dados organizados, skills governadas e IA como copiloto para acelerar entregas com validação humana" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=15;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1200" height="28" as="geometry" />
        </mxCell>

        <!-- Container principal (declarado antes das caixas internas para ficar ao fundo) -->
        <mxCell id="env_container" value="&lt;b&gt;AMBIENTE DO ESPECIALISTA&lt;/b&gt;&lt;div style=&quot;font-size: 11px; font-weight: normal; color: #166534; margin-top: 2px;&quot;&gt;Máquina local / Harness pronto (ou assinatura Enterprise)&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fillColor=#ebfbee;strokeColor=#22c55e;strokeWidth=2;fontColor=#15803d;verticalAlign=top;align=center;spacingTop=10;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="125" width="430" height="250" as="geometry" />
        </mxCell>

        <!-- Camada de dados e entrada -->
        <mxCell id="fontes" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;FONTES BRUTAS&lt;/b&gt;&lt;div style=&quot;font-size: 11px; color: #334155; margin-top: 6px;&quot;&gt;ERPs, planilhas, PDFs,&lt;br&gt;e-mails e sistemas&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#a5d8ff;strokeColor=#4a9eed;strokeWidth=2;fontColor=#1e1e1e;" vertex="1" parent="1">
          <mxGeometry x="30" y="135" width="170" height="90" as="geometry" />
        </mxCell>

        <mxCell id="preproc" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;PRÉ-PROCESSAMENTO&lt;/b&gt;&lt;div style=&quot;font-size: 11px; color: #334155; margin-top: 6px;&quot;&gt;Coleta, limpa, estrutura&lt;br&gt;e padroniza os dados&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#a5d8ff;strokeColor=#4a9eed;strokeWidth=2;fontColor=#1e1e1e;" vertex="1" parent="1">
          <mxGeometry x="30" y="265" width="170" height="90" as="geometry" />
        </mxCell>

        <mxCell id="dados" value="&lt;b style=&quot;font-size: 12.5px;&quot;&gt;CAMADA CENTRALIZADA&lt;br&gt;DE DADOS&lt;/b&gt;&lt;div style=&quot;font-size: 11px; color: #1e293b; margin-top: 10px;&quot;&gt;RAG / base vetorial&lt;br&gt;&lt;b&gt;ou&lt;/b&gt;&lt;br&gt;Pastas compartilháveis&lt;br&gt;(OneDrive / SharePoint)&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#a5d8ff;strokeColor=#4a9eed;strokeWidth=2;fontColor=#1e1e1e;" vertex="1" parent="1">
