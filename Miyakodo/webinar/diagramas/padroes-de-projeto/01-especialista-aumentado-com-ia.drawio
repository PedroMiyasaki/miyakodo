          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Conexoes de governanca e skills -->
        <mxCell id="e_val_skills" value="escrevem e&lt;br&gt;validam" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;endArrow=classic;endFill=1;fontSize=13;fontStyle=1;fontColor=#15803d;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="validadores" target="skills">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_skills_ia" value="IA usa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;endArrow=classic;endFill=1;fontSize=13;fontStyle=1;fontColor=#15803d;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.2372;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="skills" target="ia">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e_esp_skills" value="aciona e opera" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;endArrow=classic;endFill=1;fontSize=13;fontStyle=1;fontColor=#15803d;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7628;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="especialista" target="skills">
          <mxGeometry x="0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Faixa inferior: ganhos-chave -->
        <mxCell id="bottom_title" value="Por que esse padrão vence substituir o especialista:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#1e1e1e;" vertex="1" parent="1">
          <mxGeometry x="40" y="632" width="700" height="28" as="geometry" />
        </mxCell>

        <mxCell id="card_1" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;1. Multiplica a capacidade sem perder controle&lt;/b&gt;&lt;div style=&quot;font-size: 12px; color: #1e293b; margin-top: 8px;&quot;&gt;A IA lê dados, cruza contexto e gera rascunhos em minutos; o especialista foca em julgar exceções e assinar a entrega.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=12;align=left;verticalAlign=middle;fillColor=#b2f2bb;strokeColor=#22c55e;strokeWidth=2;fontColor=#1e1e1e;" vertex="1" parent="1">
          <mxGeometry x="40" y="672" width="380" height="118" as="geometry" />
        </mxCell>

        <mxCell id="card_2" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;2. O método vira ativo governado em skills&lt;/b&gt;&lt;div style=&quot;font-size: 12px; color: #1e293b; margin-top: 8px;&quot;&gt;O conhecimento do time sai de prompts soltos e vai para um repositório centralizado, versionado e validado em casos reais.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=12;align=left;verticalAlign=middle;fillColor=#b2f2bb;strokeColor=#22c55e;strokeWidth=2;fontColor=#1e1e1e;" vertex="1" parent="1">
          <mxGeometry x="450" y="672" width="380" height="118" as="geometry" />
        </mxCell>

        <mxCell id="card_3" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;3. Adoção rápida e ajuste sem depender da TI&lt;/b&gt;&lt;div style=&quot;font-size: 12px; color: #1e293b; margin-top: 8px;&quot;&gt;Começa em harness pronto conectado aos dados; quando uma política muda, validadores ajustam a skill sem projeto de software.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=12;align=left;verticalAlign=middle;fillColor=#b2f2bb;strokeColor=#22c55e;strokeWidth=2;fontColor=#1e1e1e;" vertex="1" parent="1">
          <mxGeometry x="860" y="672" width="380" height="118" as="geometry" />
        </mxCell>
      </root>
