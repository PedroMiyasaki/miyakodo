        <!-- Governanca e repositorio de skills -->
        <mxCell id="validadores" value="&lt;b style=&quot;font-size: 12.5px;&quot;&gt;ESPECIALISTAS DE VALIDAÇÃO&lt;/b&gt;&lt;div style=&quot;font-size: 11px; font-weight: bold; color: #b45309; margin-top: 4px;&quot;&gt;Human-in-the-loop de governança&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #1e293b; margin-top: 8px;&quot;&gt;Escrevem, versionam e testam skills&lt;br&gt;com Evals em casos reais&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#fff3bf;strokeColor=#f59e0b;strokeWidth=3;fontColor=#1e1e1e;" vertex="1" parent="1">
          <mxGeometry x="228" y="455" width="240" height="120" as="geometry" />
        </mxCell>

        <mxCell id="skills" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;REPOSITÓRIO CENTRALIZADO DE SKILLS&lt;/b&gt;&lt;div style=&quot;font-size: 12px; color: #1e293b; margin-top: 8px;&quot;&gt;Regras de negócio, métodos, critérios e resources oficiais&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #334155; margin-top: 6px;&quot;&gt;Pasta governada (SharePoint / OneDrive), GitHub ou solução interna&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#c3fae8;strokeColor=#06b6d4;strokeWidth=2;fontColor=#1e1e1e;" vertex="1" parent="1">
          <mxGeometry x="600" y="455" width="430" height="120" as="geometry" />
        </mxCell>

        <!-- Conexoes do fluxo principal -->
        <mxCell id="e_fontes_preproc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;endArrow=classic;endFill=1;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fontes" target="preproc">
          <mxGeometry relative="1" as="geometry" />
