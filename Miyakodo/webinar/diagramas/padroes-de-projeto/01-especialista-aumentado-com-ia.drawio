        <!-- Caixas internas do ambiente do especialista -->
        <mxCell id="ia" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;IA (COPILOTO)&lt;/b&gt;&lt;div style=&quot;font-size: 11px; font-weight: bold; color: #5b21b6; margin-top: 4px;&quot;&gt;Claude, Codex, Cursor&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #1e293b; margin-top: 10px;&quot;&gt;Agente assistido: lê dados,&lt;br&gt;aplica skills e gera&lt;br&gt;rascunhos e análises&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#d0bfff;strokeColor=#8b5cf6;strokeWidth=2;fontColor=#1e1e1e;" vertex="1" parent="1">
          <mxGeometry x="618" y="195" width="168" height="160" as="geometry" />
        </mxCell>

        <mxCell id="especialista" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;ESPECIALISTA&lt;/b&gt;&lt;div style=&quot;font-size: 11px; font-weight: bold; color: #b45309; margin-top: 4px;&quot;&gt;Human-in-the-loop&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #1e293b; margin-top: 10px;&quot;&gt;Direciona o caso, julga&lt;br&gt;exceções, revisa e&lt;br&gt;aprova a entrega&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#fff3bf;strokeColor=#f59e0b;strokeWidth=3;fontColor=#1e1e1e;" vertex="1" parent="1">
          <mxGeometry x="844" y="195" width="168" height="160" as="geometry" />
        </mxCell>

        <!-- Saida aprovada -->
        <mxCell id="saida" value="&lt;b style=&quot;font-size: 12.5px;&quot;&gt;SAÍDA(S) APROVADA(S)&lt;/b&gt;&lt;div style=&quot;font-size: 11px; color: #1e293b; margin-top: 10px;&quot;&gt;1 ou vários tipos de entrega&lt;br&gt;(relatório, parecer, análise)&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #166534; margin-top: 10px;&quot;&gt;&lt;b&gt;Saída estruturada&lt;/b&gt; quando&lt;br&gt;integra sistemas (ERP, CRM)&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#b2f2bb;strokeColor=#22c55e;strokeWidth=2;fontColor=#1e1e1e;" vertex="1" parent="1">
          <mxGeometry x="1062" y="185" width="188" height="180" as="geometry" />
