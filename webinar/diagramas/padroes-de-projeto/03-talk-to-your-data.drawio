        <!-- Faixa Inferior: Ganhos-chave -->
        <mxCell id="footer_title" value="Por que esse padrão entrega números confiáveis:" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=0;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#1e1e1e;" vertex="1" parent="1">
          <mxGeometry x="40" y="632" width="1200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="card_1" value="&lt;b&gt;1. Conta no banco, nunca na IA&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;A IA traduz a pergunta em consulta, mas quem faz a matemática é o banco em modo somente leitura, eliminando chutes numéricos." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#b2f2bb;strokeColor=#22c55e;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#1e1e1e;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="672" width="380" height="118" as="geometry" />
        </mxCell>
        <mxCell id="card_2" value="&lt;b&gt;2. Definição única de KPIs e Skills&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Camada semântica, views curadas com permissão por cargo e skills oficiais impedem que cada área chegue a um número diferente." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#b2f2bb;strokeColor=#22c55e;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#1e1e1e;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="672" width="380" height="118" as="geometry" />
        </mxCell>
        <mxCell id="card_3" value="&lt;b&gt;3. Auditoria de filtros e Evals contínuos&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Cada resposta mostra período e filtros aplicados, enquanto uma bateria de gabarito do financeiro valida precisão a cada alteração." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#b2f2bb;strokeColor=#22c55e;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#1e1e1e;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="672" width="380" height="118" as="geometry" />
