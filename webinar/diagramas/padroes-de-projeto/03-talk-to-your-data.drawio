          <mxGeometry x="285" y="435" width="295" height="135" as="geometry" />
        </mxCell>
        <mxCell id="node_skills" value="&lt;b&gt;Repositório de Skills&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Análises recorrentes padronizadas: fechamento de margem, curva ABC de clientes e aging de inadimplência" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#c3fae8;strokeColor=#06b6d4;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#1e1e1e;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="625" y="435" width="285" height="135" as="geometry" />
