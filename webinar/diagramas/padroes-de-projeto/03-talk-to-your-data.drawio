        <mxCell id="node_data" value="&lt;b&gt;Camada de Dados Governada&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(somente leitura)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Views curadas de ERP, CRM e financeiro com permissão por cargo via MCP / Tools.&lt;br/&gt;&lt;b&gt;Banco executa o cálculo exato.&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#a5d8ff;strokeColor=#4a9eed;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#1e1e1e;spacing=8;" vertex="1" parent="1">
