      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Cabeçalho -->
        <mxCell id="header_title" value="Padrão 3: Talk to your data" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=0;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=26;fontStyle=1;fontColor=#1e1e1e;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="header_subtitle" value="A IA traduz a pergunta de negócio para consulta e o banco executa o cálculo determinístico" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=0;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=15;fontStyle=0;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1200" height="28" as="geometry" />
        </mxCell>

        <!-- Zona Container Principal (declarada antes das caixas internas para ficar no fundo) -->
        <mxCell id="zone_harness" value="&lt;b&gt;HARNESS ANALÍTICO&lt;/b&gt;  |  Workflow / Agente + Model Routing + Memória da sessão" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ebfbee;strokeColor=#22c55e;strokeWidth=2;verticalAlign=top;align=left;spacingTop=10;spacingLeft=14;fontFamily=Helvetica;fontSize=13;fontColor=#15803d;" vertex="1" parent="1">
          <mxGeometry x="265" y="115" width="665" height="480" as="geometry" />
        </mxCell>

        <!-- Coluna Esquerda: Usuário e Superfície -->
        <mxCell id="node_user" value="&lt;b&gt;Sócio / Gestor&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Pergunta em linguagem natural&lt;br/&gt;&lt;i&gt;&quot;Por que a margem caiu no trimestre?&quot;&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff3bf;strokeColor=#f59e0b;strokeWidth=3;fontFamily=Helvetica;fontSize=13;fontColor=#1e1e1e;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="165" width="185" height="145" as="geometry" />
        </mxCell>
        <mxCell id="node_surface" value="&lt;b&gt;Superfície de Entrega&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;App em nuvem (portal, Slack, Teams) ou Workspace via MCP" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#c3fae8;strokeColor=#06b6d4;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#1e1e1e;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="375" width="185" height="125" as="geometry" />
        </mxCell>

        <!-- Caixas Internas do Harness Analítico -->
        <mxCell id="node_agent" value="&lt;b&gt;Workflow / Agente Analítico&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;System Prompt antialucinação&lt;br/&gt;Model Routing (simples vs. investigativo)&lt;br/&gt;Memória contínua da sessão" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d0bfff;strokeColor=#8b5cf6;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#1e1e1e;spacing=8;" vertex="1" parent="1">
