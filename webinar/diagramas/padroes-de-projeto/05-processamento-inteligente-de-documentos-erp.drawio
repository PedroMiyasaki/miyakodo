<mxfile host="app.diagrams.net" agent="Miyakodo Webinar">
  <diagram id="padrao-05" name="Processamento de documentos ERP">
    <mxGraphModel dx="1280" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="860" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Cabecalho -->
        <mxCell id="title" value="Padrão 5: Processamento inteligente de documentos para o ERP" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=26;fontStyle=1;fontColor=#1e1e1e;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Pipeline em background sem chat: Workflow previsível, Saída estruturada e validação por exceção" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=15;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1200" height="28" as="geometry" />
        </mxCell>

        <!-- Container principal (vem antes das caixas internas para ficar no fundo) -->
        <mxCell id="zone-pipeline" value="PIPELINE EM NUVEM | Workflow + Harness enxuto em background" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ebfbee;strokeColor=#22c55e;strokeWidth=2;verticalAlign=top;align=left;spacingTop=10;spacingLeft=14;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="240" y="118" width="566" height="474" as="geometry" />
        </mxCell>

        <!-- Entrada de documentos -->
        <mxCell id="box-entrada" value="&lt;b&gt;Entrada de&lt;br&gt;documentos&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;E-mail, portal, pasta&lt;br&gt;ou scanner&lt;br&gt;&lt;br&gt;PDFs, notas fiscais,&lt;br&gt;ordens de compra e&lt;br&gt;romaneios&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#a5d8ff;strokeColor=#4a9eed;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1e1e1e;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="162" width="180" height="176" as="geometry" />
        </mxCell>

        <!-- Etapa 1: Classificacao e Extracao -->
        <mxCell id="box-extracao" value="&lt;b&gt;1. Classificação e Extração&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;One-off LLM call por etapa&lt;br&gt;Model Routing (modelo barato&lt;br&gt;primeiro, forte se ambíguo)&lt;br&gt;&lt;br&gt;&lt;b&gt;Saída estruturada&lt;/b&gt; de campos&lt;br&gt;com nível de confiança&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d0bfff;strokeColor=#8b5cf6;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1e1e1e;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="258" y="170" width="230" height="160" as="geometry" />
        </mxCell>

        <!-- Etapa 2: Validacao deterministica -->
        <mxCell id="box-validacao" value="&lt;b&gt;2. Validação determinística&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Código tradicional confere:&lt;br&gt;CNPJ, soma de itens, pedido,&lt;br&gt;tolerância e alçada&lt;br&gt;&lt;br&gt;Checa grau de confiança e&lt;br&gt;evita duplicidade&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffd8a8;strokeColor=#f59e0b;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1e1e1e;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="558" y="170" width="230" height="160" as="geometry" />
        </mxCell>

        <!-- Repositorio de Skills -->
        <mxCell id="box-skills" value="&lt;b&gt;Repositório de Skills&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Regras de leitura, normalização&lt;br&gt;e exceção por tipo de documento&lt;br&gt;(atualizadas pelo financeiro)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#c3fae8;strokeColor=#06b6d4;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1e1e1e;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="258" y="402" width="230" height="120" as="geometry" />
        </mxCell>

        <!-- Camada de dados e acoes (ERP) -->
        <mxCell id="box-erp-dados" value="&lt;b&gt;Camada de dados e ações&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;ERP, WMS e cadastros via&lt;br&gt;&lt;b&gt;MCP / Tools&lt;/b&gt; em tempo real&lt;br&gt;(fornecedores, pedidos e saldos)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#c3fae8;strokeColor=#06b6d4;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1e1e1e;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="558" y="402" width="230" height="120" as="geometry" />
        </mxCell>

        <!-- Rodape do container: Harness enxuto e Evals -->
        <mxCell id="box-harness-evals" value="&lt;b&gt;Harness enxuto:&lt;/b&gt; proibido chutar campos, trilha de auditoria e &lt;b&gt;Evals&lt;/b&gt; campo a campo" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#86efac;strokeWidth=1;fontFamily=Helvetica;fontSize=12;fontColor=#166534;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="258" y="538" width="530" height="38" as="geometry" />
        </mxCell>

        <!-- Saida A: Lancamento automatico no ERP -->
        <mxCell id="box-lancamento" value="&lt;b&gt;Lançamento automático&lt;br&gt;no ERP / Financeiro&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Registro direto sem digitação&lt;br&gt;manual, vinculado ao documento&lt;br&gt;original para auditoria&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#b2f2bb;strokeColor=#22c55e;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#1e1e1e;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1016" y="146" width="234" height="160" as="geometry" />
        </mxCell>

        <!-- Saida B: Human-in-the-loop (Excecoes) -->
        <mxCell id="box-hitl" value="&lt;b&gt;Human-in-the-loop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;(Fila de exceções)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Analista revisa só divergências&lt;br&gt;de valor, CNPJ novo ou campos&lt;br&gt;ilegíveis, lado a lado com o&lt;br&gt;documento original&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff3bf;strokeColor=#f59e0b;strokeWidth=3;fontFamily=Helvetica;fontSize=14;fontColor=#1e1e1e;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1016" y="386" width="234" height="190" as="geometry" />
        </mxCell>

        <!-- Conexoes -->
        <mxCell id="edge-entrada-extracao" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="box-entrada" target="box-extracao">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge-extracao-validacao" value="campos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="box-extracao" target="box-validacao">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge-skills-extracao" value="aplica regras" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="box-skills" target="box-extracao">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge-validacao-erp" value="cruza cadastros e pedidos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;startArrow=classic;startFill=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="box-validacao" target="box-erp-dados">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge-validacao-lancamento" value="Dados batem + alta&lt;br&gt;confiança (80% a 90%)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="box-validacao" target="box-lancamento">
          <mxGeometry x="0.08" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="edge-validacao-hitl" value="Divergência ou baixa&lt;br&gt;confiança (10% a 20%)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#b45309;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="box-validacao" target="box-hitl">
          <mxGeometry x="0.54" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="824" y="290" />
              <mxPoint x="824" y="481" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="edge-hitl-lancamento" value="após aprovação" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="box-hitl" target="box-lancamento">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Separador da faixa inferior -->
        <mxCell id="divider-bottom" value="" style="endArrow=none;html=1;strokeColor=#e2e8f0;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="40" y="612" as="sourcePoint" />
            <mxPoint x="1240" y="612" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Faixa inferior: Cards de ROI -->
        <mxCell id="roi-title" value="Por que esse padrão traz ROI rápido sem precisar de chat:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#1e1e1e;" vertex="1" parent="1">
          <mxGeometry x="40" y="632" width="1200" height="30" as="geometry" />
        </mxCell>

        <mxCell id="card-roi-1" value="&lt;b&gt;1. IA lê o caos, código valida a conta&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;A IA foca só em extrair campos estruturados de layouts variados. Regras determinísticas conferem CNPJ, somas, pedido e alçada com precisão total.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#b2f2bb;strokeColor=#22c55e;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1e1e1e;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="672" width="380" height="118" as="geometry" />
        </mxCell>

        <mxCell id="card-roi-2" value="&lt;b&gt;2. Gestão por exceção libera o time&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;De 80% a 90% dos documentos limpos entram direto no ERP. O analista confere apenas os 10% a 20% com divergência, lado a lado com o original.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#b2f2bb;strokeColor=#22c55e;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1e1e1e;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="672" width="380" height="118" as="geometry" />
        </mxCell>

        <mxCell id="card-roi-3" value="&lt;b&gt;3. Alto volume com custo baixo e Evals claros&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Model Routing usa modelos baratos no grosso do volume e escala só nos casos ambíguos. Acurácia medida campo a campo sobre histórico real.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#b2f2bb;strokeColor=#22c55e;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1e1e1e;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="672" width="380" height="118" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
