<mxfile host="app.diagrams.net" modified="2026-11-22T19:30:00.000Z" agent="Cursor" version="24.7.17" type="device">
  <diagram id="padrao-02" name="IA em atendimento de clientes">
    <mxGraphModel dx="1280" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="860" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Cabecalho -->
        <mxCell id="header-title" value="Padrão 2: IA em atendimento de clientes (vendas e afins)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=26;fontStyle=1;fontColor=#1e1e1e;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="header-subtitle" value="Atendimento receptivo e venda ativa em escala, com memória persistida por cliente e trava humana nas decisões críticas" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1200" height="28" as="geometry"/>
        </mxCell>

        <!-- Zona Container Principal (declarada antes das caixas internas para ficar no fundo) -->
        <mxCell id="zone-cloud-app" value="APLICAÇÃO CUSTOMIZADA NA NUVEM  |  Harness próprio" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ebfbee;strokeColor=#22c55e;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontStyle=1;fontColor=#15803d;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="332" y="115" width="596" height="480" as="geometry"/>
        </mxCell>

        <!-- Entrada / Saida externa: Canais do cliente -->
        <mxCell id="box-canais" value="&lt;div style='font-size:15px;font-weight:700;margin-bottom:10px;'&gt;Canais do cliente&lt;/div&gt;&lt;div style='font-size:13px;line-height:1.4;margin-bottom:12px;'&gt;WhatsApp, chat do site,&lt;br&gt;Instagram e e-mail&lt;/div&gt;&lt;div style='font-size:12px;color:#555555;line-height:1.35;'&gt;Ponto único para responder dúvidas e abordar clientes em venda ativa&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#ffd8a8;strokeColor=#f59e0b;strokeWidth=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="245" width="176" height="220" as="geometry"/>
        </mxCell>

        <!-- Nucleo IA interno: Agente + Workflows criticos -->
        <mxCell id="box-agente" value="&lt;div style='font-size:15px;font-weight:700;margin-bottom:6px;'&gt;Agente de Atendimento + Workflows críticos&lt;/div&gt;&lt;div style='font-size:12.5px;line-height:1.35;margin-bottom:10px;'&gt;Agente conduz a conversa natural e a venda ativa;&lt;br&gt;Workflows garantem etapas previsíveis (pedido, cobrança e estorno)&lt;/div&gt;&lt;div style='font-size:12px;font-weight:700;color:#4c1d95;'&gt;System Prompt próprio  |  Toolset customizado  |  Model Routing&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#d0bfff;strokeColor=#8b5cf6;strokeWidth=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="390" y="168" width="480" height="136" as="geometry"/>
        </mxCell>

        <!-- Camadas internas conectadas ao Agente -->
        <mxCell id="box-persistencia" value="&lt;div style='font-size:14px;font-weight:700;margin-bottom:8px;'&gt;Camada de Persistência&lt;/div&gt;&lt;div style='font-size:12px;line-height:1.38;margin-bottom:8px;'&gt;Histórico de conversas, compras e preferências por cliente.&lt;/div&gt;&lt;div style='font-size:11.5px;color:#0e7490;font-weight:700;'&gt;Memória contínua para atendimento e venda ativa&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#c3fae8;strokeColor=#06b6d4;strokeWidth=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="348" y="394" width="180" height="176" as="geometry"/>
        </mxCell>

        <mxCell id="box-regras-dados" value="&lt;div style='font-size:14px;font-weight:700;margin-bottom:8px;'&gt;Regras, Políticas e Dados&lt;/div&gt;&lt;div style='font-size:12px;line-height:1.38;margin-bottom:8px;'&gt;Catálogo, preços, prazos e consultas a ERP e CRM.&lt;/div&gt;&lt;div style='font-size:11.5px;color:#0e7490;font-weight:700;'&gt;Base centralizada via RAG, MCP e Tools&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#c3fae8;strokeColor=#06b6d4;strokeWidth=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="540" y="394" width="180" height="176" as="geometry"/>
        </mxCell>

        <mxCell id="box-skills" value="&lt;div style='font-size:14px;font-weight:700;margin-bottom:8px;'&gt;Repositório de Skills&lt;/div&gt;&lt;div style='font-size:12px;line-height:1.38;margin-bottom:8px;'&gt;Métodos comerciais: qualificação, venda ativa, objeções e trocas.&lt;/div&gt;&lt;div style='font-size:11.5px;color:#0e7490;font-weight:700;'&gt;Roteiros reutilizáveis em fonte única&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#c3fae8;strokeColor=#06b6d4;strokeWidth=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="732" y="394" width="180" height="176" as="geometry"/>
        </mxCell>

        <!-- Saidas a direita -->
        <mxCell id="box-sistemas" value="&lt;div style='font-size:15px;font-weight:700;margin-bottom:6px;'&gt;Sistemas da empresa&lt;/div&gt;&lt;div style='font-size:12px;font-weight:700;color:#1d4ed8;margin-bottom:10px;'&gt;CRM  |  ERP  |  Pedidos&lt;/div&gt;&lt;div style='font-size:12px;line-height:1.4;'&gt;Recebe saída estruturada da conversa: atualiza funil, registra pedido, abre ticket e mantém o histórico sincronizado.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#a5d8ff;strokeColor=#4a9eed;strokeWidth=2;fontColor=#1e1e1e;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1048" y="135" width="192" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="box-hitl" value="&lt;div style='font-size:15px;font-weight:700;margin-bottom:6px;'&gt;Human-in-the-loop&lt;/div&gt;&lt;div style='font-size:12px;font-weight:700;color:#b45309;margin-bottom:10px;'&gt;Validação obrigatória&lt;/div&gt;&lt;div style='font-size:12px;line-height:1.4;'&gt;Trava antes de decisões críticas: devolução de dinheiro, desconto fora da regra ou exceção sensível. Humano aprova, ajusta ou assume.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=8;fillColor=#fff3bf;strokeColor=#f59e0b;strokeWidth=3;fontColor=#1e1e1e;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1048" y="375" width="192" height="200" as="geometry"/>
        </mxCell>

        <!-- Faixa inferior: Subtitulo + 3 cards de ganho -->
        <mxCell id="footer-title" value="Por que esse padrão escala vendas sem perder controle:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#1e1e1e;" vertex="1" parent="1">
          <mxGeometry x="40" y="632" width="1200" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="card-1" value="&lt;div style='font-size:14px;font-weight:700;margin-bottom:6px;'&gt;1. Memória por cliente habilita venda ativa&lt;/div&gt;&lt;div style='font-size:12.5px;line-height:1.4;'&gt;A persistência grava histórico, compras e preferências. A IA atende sem repetir perguntas e sugere reposição ou retomada de orçamento no momento certo.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=10;fillColor=#b2f2bb;strokeColor=#22c55e;strokeWidth=2;fontColor=#1e1e1e;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="672" width="380" height="118" as="geometry"/>
        </mxCell>

        <mxCell id="card-2" value="&lt;div style='font-size:14px;font-weight:700;margin-bottom:6px;'&gt;2. Regras centralizadas e trava humana&lt;/div&gt;&lt;div style='font-size:12.5px;line-height:1.4;'&gt;Políticas, preços e skills ficam em fonte única. O agente resolve o padrão com autonomia e trava para aprovação humana em reembolso ou desconto excepcional.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=10;fillColor=#b2f2bb;strokeColor=#22c55e;strokeWidth=2;fontColor=#1e1e1e;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="450" y="672" width="380" height="118" as="geometry"/>
        </mxCell>

        <mxCell id="card-3" value="&lt;div style='font-size:14px;font-weight:700;margin-bottom:6px;'&gt;3. Escala com custo e qualidade sob controle&lt;/div&gt;&lt;div style='font-size:12.5px;line-height:1.4;'&gt;Model Routing usa modelos rápidos em mensagens simples e modelos mais capazes na negociação. Saídas estruturadas atualizam CRM/ERP e Evals medem a qualidade.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;spacing=10;fillColor=#b2f2bb;strokeColor=#22c55e;strokeWidth=2;fontColor=#1e1e1e;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="860" y="672" width="380" height="118" as="geometry"/>
        </mxCell>

        <!-- Conexoes / Setas -->
        <mxCell id="edge-canais-app" value="Atendimento&lt;br&gt;+ venda ativa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;startArrow=classic;startFill=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="box-canais" target="zone-cloud-app">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge-agente-persistencia" value="lê e grava" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;startArrow=classic;startFill=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ebfbee;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="box-agente" target="box-persistencia">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge-agente-regras" value="consulta (Toolset)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ebfbee;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="box-agente" target="box-regras-dados">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge-agente-skills" value="aplica skills" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ebfbee;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="box-agente" target="box-skills">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge-app-sistemas" value="Saída&lt;br&gt;estruturada" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="zone-cloud-app" target="box-sistemas">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge-app-hitl" value="Decisão crítica&lt;br&gt;(aprovação)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1e1e1e;strokeWidth=2;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=13;fontColor=#15803d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="zone-cloud-app" target="box-hitl">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
