        <!-- Faixa inferior: 3 ganhos / decisoes-chave -->
        <mxCell id="lbl-ganhos" value="Por que esse padrão tira compliance do gargalo manual:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#1e1e1e;" vertex="1" parent="1">
          <mxGeometry x="40" y="632" width="1200" height="28" as="geometry" />
        </mxCell>

        <mxCell id="card-1" value="&lt;b&gt;1. Fonte única viva e curada por humanos&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Agentes monitoram leis e normas em paralelo na nuvem, mas nada entra na base oficial sem aprovação do time jurídico ou de compliance." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#b2f2bb;strokeColor=#22c55e;strokeWidth=2;fontColor=#1e1e1e;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="672" width="380" height="118" as="geometry" />
        </mxCell>

        <mxCell id="card-2" value="&lt;b&gt;2. Pessoas e sistemas na mesma base oficial&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;As equipes validam materiais via MCP e Skills nas próprias ferramentas de IA, enquanto sistemas checam textos automaticamente via API." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#b2f2bb;strokeColor=#22c55e;strokeWidth=2;fontColor=#1e1e1e;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="672" width="380" height="118" as="geometry" />
        </mxCell>

        <mxCell id="card-3" value="&lt;b&gt;3. Decisão auditável com Evals e API estruturada&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;A API devolve conformidade, motivo e norma de referência para travar ou alertar o fluxo, com Evals garantindo precisão a cada nova lei." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#b2f2bb;strokeColor=#22c55e;strokeWidth=2;fontColor=#1e1e1e;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="672" width="380" height="118" as="geometry" />
        </mxCell>
      </root>
